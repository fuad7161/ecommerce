# Production settings — copy to .env.production and replace EVERY value.
DOMAIN=shop.example.com
ACME_EMAIL=you@example.com
APP_VERSION=1.0.0

# openssl rand -hex 32
SECRET_KEY=
AUTO_MIGRATE=true
MAX_UPLOAD_MB=5
CACHE_TTL=60s

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=
POSTGRES_DB=ecommerce
REDIS_PASSWORD=
MINIO_ROOT_USER=ecommerce
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ecommerce

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_AUTO_SEND=false
STEADFAST_SYNC_INTERVAL=30m

BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# SSLCommerz online payments (live). APP_URL must be publicly reachable over HTTPS so the
# gateway can send customers back and deliver IPN notifications to /payment/sslcommerz/ipn.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false
PAYMENT_TIMEOUT=60m

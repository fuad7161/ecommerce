# Copy to .env and change every secret before deploying.

APP_ENV=development
APP_URL=http://localhost:8080
APP_PORT=8080
HTTP_ADDR=:8080

# 32+ random characters. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-0123456789abcdef

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# Trust X-Forwarded-For/X-Real-IP for client IPs. Only enable behind a reverse proxy.
TRUST_PROXY=false
# How long homepage/catalog data is cached in Redis (admin edits invalidate it immediately).
CACHE_TTL=60s
AUTO_MIGRATE=true
MAX_UPLOAD_MB=5

# PostgreSQL
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce-dev-password
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (object storage for product images)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio-dev-password
MINIO_BUCKET=ecommerce
MINIO_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# First admin account, created by `make seed` when no admin exists.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
# Set to true to skip downloading placeholder product photos from picsum.photos.
SEED_OFFLINE=false

# Steadfast Courier (https://portal.packzy.com). Leave empty to disable the integration.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
# Create the consignment automatically when an admin confirms an order.
STEADFAST_AUTO_SEND=false
# How often delivery statuses are polled from Steadfast.
STEADFAST_SYNC_INTERVAL=30m
